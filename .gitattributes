# Let Git detect binary files; keep repository text deterministic on every OS.
* text=auto eol=lf

# Source and data formats used by this repository
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.lua  text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.ini  text eol=lf
*.conf text eol=lf
VERSION text eol=lf

# Native Windows scripts conventionally require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never run line-ending conversion on binary assets or release archives.
*.exe  binary
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.zip  binary
*.7z   binary
*.bin  binary
*.pdf  binary

# Generated upstream/curated outputs: keep them versioned, but let GitHub fold
# their very large diffs and exclude them from repository language statistics.
dicts/eosphoros/eosphoros.danzi.dict.yaml         linguist-generated=true
dicts/eosphoros/eosphoros.ice.dict.yaml           linguist-generated=true
dicts/eosphoros/eosphoros.en.dict.yaml            linguist-generated=true
dicts/eosphoros/eosphoros.wanxiang.*.dict.yaml    linguist-generated=true
dicts/eosphoros/eosphoros.protestantism.dict.yaml linguist-generated=true
dicts/eosphoros/eosphoros.orthodoxy.dict.yaml     linguist-generated=true
dicts/eosphoros/eosphoros.oriental.dict.yaml      linguist-generated=true
dicts/eosphoros/eosphoros.assyrian.dict.yaml      linguist-generated=true
opencc/eosphoros/*.lua            linguist-generated=true
fcitx5/**                       linguist-generated=true
